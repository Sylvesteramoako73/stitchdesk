# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                 # e.g. https://app.stitchdeskapp.online (used in tracking links and reminders)
NEXT_PUBLIC_MARKETING_HOSTS=         # optional, defaults to stitchdeskapp.online,www.stitchdeskapp.online
NEXT_PUBLIC_GA_ID=                   # optional Google Analytics 4 ID for StitchDesk

# ── Firebase web app (public, safe to expose) ─────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only, never expose) ────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                # full key including the BEGIN and END lines

# ── Subscription billing through Paystack (your StitchDesk account) ───────────
NEXT_PUBLIC_PAYSTACK_PLATFORM_KEY=   # pk_live_xxx
PAYSTACK_PLATFORM_SECRET_KEY=        # sk_live_xxx  (required in production, plans will not activate without it)

# ── Daily reminders job (Vercel Cron calls /api/cron) ─────────────────────────
CRON_SECRET=                         # long random string; set the same value in Vercel

# ── Optional: automatic SMS and WhatsApp to clients ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=                # whatsapp:+14155238886
META_WHATSAPP_ACCESS_TOKEN=          # or use the WhatsApp Cloud API
META_WHATSAPP_PHONE_NUMBER_ID=
RAILWAY_WHATSAPP_URL=                # if you use the same WhatsApp bridge as GlowDesk
RAILWAY_WHATSAPP_SESSION=default

# ── Optional: email ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=                         # StitchDesk <hello@stitchdeskapp.online>

# ── Web push (optional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Platform admin (/admin) ───────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=                   # the StitchDesk account allowed into /admin
